# Create .env from this file. Never commit the real values.
SESSION_SECRET=replace-with-a-long-random-secret
# Generate with: node -e "import('bcryptjs').then(({default:bcrypt})=>bcrypt.hash('choose-a-password',12).then(console.log))"
ADMIN_PASSWORD_HASH=$2b$12$replace-with-a-real-bcrypt-hash
# Comma-separated domains approved for HTTPS game embeds, e.g. games.example.com
TRUSTED_EMBED_DOMAINS=games.example.com
DATABASE_PATH=./data/playnest.db
API_PORT=3001
